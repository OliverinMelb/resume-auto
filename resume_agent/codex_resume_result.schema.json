{
  "$defs": {
    "ClaimAudit": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "source_resume_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Resume Ids",
          "type": "array"
        },
        "source_quotes": {
          "items": {
            "type": "string"
          },
          "title": "Source Quotes",
          "type": "array"
        },
        "job_ids": {
          "items": {
            "type": "string"
          },
          "title": "Job Ids",
          "type": "array"
        },
        "change_type": {
          "enum": [
            "unchanged",
            "compressed",
            "reordered",
            "strengthened"
          ],
          "title": "Change Type",
          "type": "string"
        },
        "fact_status": {
          "enum": [
            "source_verified",
            "user_confirmed",
            "unverified"
          ],
          "title": "Fact Status",
          "type": "string"
        },
        "measurement_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Basis"
        },
        "claim_status": {
          "enum": [
            "verified",
            "reframed",
            "in_progress"
          ],
          "title": "Claim Status",
          "type": "string"
        },
        "gap_id": {
          "anyOf": [
            {
              "pattern": "^gap-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Id"
        },
        "acceptance_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Id"
        }
      },
      "required": [
        "claim",
        "source_resume_ids",
        "source_quotes",
        "job_ids",
        "change_type",
        "fact_status",
        "claim_status"
      ],
      "title": "ClaimAudit",
      "type": "object"
    },
    "GapAcceptancePlan": {
      "additionalProperties": false,
      "properties": {
        "gap_id": {
          "pattern": "^gap-[0-9a-f]{12}$",
          "title": "Gap Id",
          "type": "string"
        },
        "jd_requirements": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Jd Requirements",
          "type": "array"
        },
        "project_scope": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Project Scope",
          "type": "string"
        },
        "required_artifacts": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Required Artifacts",
          "type": "array"
        },
        "test_commands": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Test Commands",
          "type": "array"
        },
        "acceptance_metrics": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Acceptance Metrics",
          "type": "array"
        },
        "interview_topics": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Interview Topics",
          "type": "array"
        }
      },
      "required": [
        "gap_id",
        "jd_requirements",
        "project_scope",
        "required_artifacts",
        "test_commands",
        "acceptance_metrics"
      ],
      "title": "GapAcceptancePlan",
      "type": "object"
    },
    "MissingInformation": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "question",
        "blocking",
        "reason"
      ],
      "title": "MissingInformation",
      "type": "object"
    },
    "RewriteReason": {
      "additionalProperties": false,
      "properties": {
        "rewritten_text": {
          "title": "Rewritten Text",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_resume_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Resume Ids",
          "type": "array"
        },
        "job_ids": {
          "items": {
            "type": "string"
          },
          "title": "Job Ids",
          "type": "array"
        }
      },
      "required": [
        "rewritten_text",
        "reason",
        "source_resume_ids",
        "job_ids"
      ],
      "title": "RewriteReason",
      "type": "object"
    },
    "RiskItem": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "text"
      ],
      "title": "RiskItem",
      "type": "object"
    },
    "ScoreItem": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "score",
        "evidence"
      ],
      "title": "ScoreItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "title": "Verdict",
      "type": "string"
    },
    "scorecard": {
      "items": {
        "$ref": "#/$defs/ScoreItem"
      },
      "title": "Scorecard",
      "type": "array"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/RiskItem"
      },
      "title": "Risks",
      "type": "array"
    },
    "missing_information": {
      "items": {
        "$ref": "#/$defs/MissingInformation"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "rewritten_resume_markdown": {
      "title": "Rewritten Resume Markdown",
      "type": "string"
    },
    "rewrite_reasons": {
      "items": {
        "$ref": "#/$defs/RewriteReason"
      },
      "title": "Rewrite Reasons",
      "type": "array"
    },
    "depth_recommendations": {
      "items": {
        "type": "string"
      },
      "title": "Depth Recommendations",
      "type": "array"
    },
    "interviewer_probes": {
      "items": {
        "type": "string"
      },
      "title": "Interviewer Probes",
      "type": "array"
    },
    "claim_audit": {
      "items": {
        "$ref": "#/$defs/ClaimAudit"
      },
      "title": "Claim Audit",
      "type": "array"
    },
    "gap_acceptance_plans": {
      "items": {
        "$ref": "#/$defs/GapAcceptancePlan"
      },
      "title": "Gap Acceptance Plans",
      "type": "array"
    }
  },
  "required": [
    "verdict",
    "scorecard",
    "risks",
    "missing_information",
    "rewritten_resume_markdown",
    "rewrite_reasons",
    "depth_recommendations",
    "interviewer_probes",
    "claim_audit",
    "gap_acceptance_plans"
  ],
  "title": "CodexRewriteResult",
  "type": "object"
}
