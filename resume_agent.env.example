# 可选：不设置时使用仓库根目录下的 resume_agent.db
RESUME_AGENT_DB_PATH=

# 可选：不设置时读取现有 job_actions.jsonl 作为历史投递事件来源
RESUME_AGENT_ACTION_LOG_PATH=

# 可选：不设置时读取现有 job_decisions.jsonl 导入已评分JD
RESUME_AGENT_DECISION_LOG_PATH=

# 默认 false：新子路由只接受本机请求。确认网络和隐私风险后才改为 true。
# Optional: defaults to PROJECT_ROOT/analysis/runs.
RESUME_AGENT_RUNS_ROOT=

# Optional: defaults to 900 seconds; allowed range is 30 to 3600.
RESUME_AGENT_CODEX_TIMEOUT_SECONDS=900

RESUME_AGENT_ALLOW_REMOTE=false

# Local research services only. Non-loopback endpoints are rejected.
RESUME_AGENT_BOSS_RESEARCH_ENDPOINT=http://127.0.0.1:8011
RESUME_AGENT_NOWCODER_RESEARCH_ENDPOINT=http://127.0.0.1:8012

# Source HTTP timeout in seconds; allowed range is 1 to 120.
RESUME_AGENT_DISCOVERY_TIMEOUT_SECONDS=30
